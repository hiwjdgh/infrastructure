# COPY INTO THE next-frontend REPO: .github/workflows/deploy.yml
# 수동 실행 전용. Actions > Deploy > Run workflow 에서 "Use workflow from" 브랜치로 대상 서버가 정해집니다.
#   dev  → test 서버 : ref 비우면 dev 최신 커밋, 지정 시 dev 에 포함된 커밋 SHA
#   main → prod 서버 : ref 비우면 최신 릴리스 태그, 지정 시 릴리스 태그(vX.Y.Z)만 허용
# 서버에는 AWS SSM 으로 명령을 보냅니다 (EC2 인바운드 포트 / SSH 키 / self-hosted runner 불필요).
# 사전 설정 — infrastructure 저장소의 docs/aws-ssm-deploy.md 참고
#   repo Settings > Environments 에 test, prod 생성 후 각각 variables:  # [ORG] org 전환 후 공통 값(AWS_REGION 등)은 org variables 로 옮길 수 있음
#     AWS_REGION           예) ap-northeast-2
#     AWS_DEPLOY_ROLE_ARN  예) arn:aws:iam::123456789012:role/github-deploy-test  (test / prod 역할이 다름)
#     DEPLOY_INSTANCE_ID   예) i-0123456789abcdef0 (해당 서버의 EC2 인스턴스 ID)
#     DEPLOY_USER          선택, 기본 ubuntu (infrastructure 를 clone 한 사용자, docker 그룹 소속)
#     DEPLOY_PATH          선택, DEPLOY_USER 홈 기준 경로, 기본 platform/infrastructure
#   Deployment branches: test → dev 만, prod → main 만 허용 / prod 에 Required reviewers 권장
# 서버에는 미리 scripts/ghcr-login.sh 로 GHCR 로그인이 되어 있어야 합니다.
name: Deploy
on:
  workflow_dispatch:
    inputs:
      action:
        description: deploy = 배포, rollback = 이전 슬롯으로 되돌리기
        type: choice
        options: [deploy, rollback]
        default: deploy
      ref:
        description: 비우면 dev=최신 커밋 / main=최신 릴리스 태그. 지정 시 dev=커밋 SHA / main=vX.Y.Z (rollback 시 무시)
        required: false
permissions:
  contents: read
  packages: read
  id-token: write  # AWS OIDC: 배포할 때마다 임시 자격 증명을 발급받음 (저장된 AWS 키 없음)
env:
  SERVICE: next-frontend
  IMAGE: ghcr.io/hiwjdgh/next-frontend  # [ORG] ghcr.io/<org>/next-frontend 로 변경
concurrency:
  group: deploy-next-frontend-${{ github.ref_name }}
  cancel-in-progress: false
jobs:
  resolve:
    runs-on: ubuntu-latest
    outputs:
      environment: ${{ steps.resolve.outputs.environment }}
      tag: ${{ steps.resolve.outputs.tag }}
      version: ${{ steps.resolve.outputs.version }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Resolve target
        id: resolve
        env:
          BRANCH: ${{ github.ref_name }}
          REF_TYPE: ${{ github.ref_type }}
          ACTION: ${{ inputs.action }}
          REF: ${{ inputs.ref }}
        run: |
          fail() { echo "::error::$1"; exit 1; }
          [[ "$REF_TYPE" == branch ]] || fail "브랜치(dev 또는 main)를 선택해서 실행하세요"
          case "$BRANCH" in
            dev)  echo "environment=test" >> "$GITHUB_OUTPUT" ;;
            main) echo "environment=prod" >> "$GITHUB_OUTPUT" ;;
            *)    fail "Deploy 는 dev(→test) 또는 main(→prod) 에서만 실행할 수 있습니다: $BRANCH" ;;
          esac
          [[ "$ACTION" == deploy ]] || exit 0
          if [[ "$BRANCH" == dev ]]; then
            COMMIT="${REF:-HEAD}"
            [[ "$COMMIT" == HEAD || "$COMMIT" =~ ^[0-9a-f]{7,40}$ ]] || fail "dev 는 커밋 SHA 만 지정할 수 있습니다: $REF"
            VERSION="$(git rev-parse --short=7 "$COMMIT")"
          else
            VERSION="${REF:-$(git tag --merged HEAD --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | sed -n 1p)}"
            [[ -n "$VERSION" ]] || fail "main 에 릴리스 태그가 없습니다. dev → main PR 머지 후 Release 워크플로 결과를 확인하세요"
            [[ "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "prod 는 릴리스 태그(vX.Y.Z)만 배포할 수 있습니다: $VERSION"
            COMMIT="refs/tags/$VERSION"
          fi
          SHA="$(git rev-parse --verify --quiet "$COMMIT^{commit}")" || fail "찾을 수 없는 ref: $COMMIT"
          git merge-base --is-ancestor "$SHA" HEAD || fail "$VERSION 은(는) $BRANCH 브랜치에 포함되어 있지 않습니다"
          { echo "tag=sha-${SHA:0:7}"; echo "version=$VERSION"; } >> "$GITHUB_OUTPUT"
      - uses: docker/login-action@v3
        if: inputs.action == 'deploy'
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Check image exists
        if: inputs.action == 'deploy'
        env:
          TAG: ${{ steps.resolve.outputs.tag }}
        run: |
          docker manifest inspect "$IMAGE:$TAG" > /dev/null \
            || { echo "::error::$IMAGE:$TAG 이미지가 없습니다. ghcr.yml 이 끝났는지 확인하세요"; exit 1; }
  deploy:
    needs: resolve
    runs-on: ubuntu-latest
    environment: ${{ needs.resolve.outputs.environment }}
    steps:
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
      - name: Run on server via SSM
        env:
          ACTION: ${{ inputs.action }}
          TAG: ${{ needs.resolve.outputs.tag }}
          VERSION: ${{ needs.resolve.outputs.version }}
          TARGET_ENV: ${{ needs.resolve.outputs.environment }}
          INSTANCE_ID: ${{ vars.DEPLOY_INSTANCE_ID }}
          DEPLOY_USER: ${{ vars.DEPLOY_USER }}
          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}
        run: |
          fail() { echo "::error::$1"; exit 1; }
          [[ "$INSTANCE_ID" =~ ^i-[0-9a-f]+$ ]] || fail "environment '$TARGET_ENV' 의 DEPLOY_INSTANCE_ID 변수를 확인하세요: '$INSTANCE_ID'"
          RUN_AS="${DEPLOY_USER:-ubuntu}"; DIR="${DEPLOY_PATH:-platform/infrastructure}"
          [[ "$RUN_AS" =~ ^[a-z_][a-z0-9_-]*$ && "$DIR" =~ ^[A-Za-z0-9._/-]+$ ]] || fail "DEPLOY_USER / DEPLOY_PATH 값을 확인하세요"
          if [[ "$ACTION" == deploy ]]; then
            [[ "$TAG" =~ ^sha-[0-9a-f]{7}$ ]] || fail "잘못된 이미지 태그: $TAG"
            CMD="./scripts/deploy-service.sh $SERVICE $TAG"
          else
            CMD="./scripts/rollback-service.sh $SERVICE"
          fi
          SCRIPT="sudo -H -u $RUN_AS bash -lc 'cd ~/$DIR && $CMD'"
          PARAMS="$(jq -cn --arg c "$SCRIPT" '{commands: [$c], executionTimeout: ["900"]}')"
          echo "→ $INSTANCE_ID ($TARGET_ENV): $SCRIPT"
          COMMAND_ID="$(aws ssm send-command \
            --instance-ids "$INSTANCE_ID" \
            --document-name AWS-RunShellScript \
            --comment "$ACTION $SERVICE ${VERSION:-} by ${GITHUB_ACTOR}" \
            --parameters "$PARAMS" \
            --query Command.CommandId --output text)"
          echo "SSM command: $COMMAND_ID"
          STATUS=Pending
          for _ in $(seq 1 180); do
            sleep 5
            STATUS="$(aws ssm get-command-invocation --command-id "$COMMAND_ID" --instance-id "$INSTANCE_ID" \
              --query Status --output text 2>/dev/null || echo Pending)"
            case "$STATUS" in Pending|InProgress|Delayed) continue ;; *) break ;; esac
          done
          aws ssm get-command-invocation --command-id "$COMMAND_ID" --instance-id "$INSTANCE_ID" \
            --query '[StandardOutputContent, StandardErrorContent]' --output text || true
          echo "$ACTION $SERVICE ${VERSION:-} (${TAG:-}) → $TARGET_ENV : $STATUS" >> "$GITHUB_STEP_SUMMARY"
          [[ "$STATUS" == Success ]] || fail "서버 실행 결과: $STATUS (위 로그 확인)"
