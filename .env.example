HTTP_PORT=8080  # 공용 Nginx 가 받는 호스트 포트 = ALB 대상 그룹(Target group)의 포트
APP_ENV=local  # local | test | prod — 앱 env 파일 경로 environments/<APP_ENV>/<service>.env 결정
# GHCR pull 계정 (scripts/ghcr-login.sh 에서 사용). 토큰은 PAT classic, read:packages 권한
GHCR_USERNAME=hiwjdgh  # [ORG] org 전환 후에도 "사람(또는 머신유저) 계정"으로 로그인함 — org 이름이 아님. 해당 계정이 org 패키지 read 권한을 가져야 함
GHCR_TOKEN=            # [ORG] org에 SAML SSO가 켜져 있으면 이 PAT를 org에 대해 SSO Authorize 해야 함

# 컨테이너 메모리 상한 (서버별). 비우면 services/<service>.conf 의 MEMORY_LIMIT(512m) 사용
# blue/green 두 슬롯이 동시에 떠 있으므로 실제 사용량은 최대 (상한 × 2) 입니다.
#   TEST (8GB) : 기본값 512m 유지 → 4서비스 × 2슬롯 × 512m = 최대 4GB
#   PROD (32GB): 예) 아래 값 → 최대 (1g + 1g + 2g + 2g) × 2 = 12GB
# MEMORY_LIMIT_PHP_FRONTEND=1g
# MEMORY_LIMIT_PHP_BACKEND=1g
# MEMORY_LIMIT_NEXT_FRONTEND=2g
# MEMORY_LIMIT_NEST_BACKEND=2g

# 서비스 도메인 (서버별). 비우면 services/<service>.conf 의 *.localhost 사용 (로컬 전용)
# ALB 가 받은 Host 헤더 그대로 들어오므로, 사용자가 접속하는 실제 도메인을 적습니다. 여러 개면 공백으로 구분
#   TEST 예) SERVER_NAME_NEXT_FRONTEND=test-www.example.com
#   PROD 예) SERVER_NAME_NEXT_FRONTEND="www.example.com example.com"
# SERVER_NAME_PHP_FRONTEND=
# SERVER_NAME_PHP_BACKEND=
# SERVER_NAME_NEXT_FRONTEND=
# SERVER_NAME_NEST_BACKEND=
